# ──────────────────────────────────────────────────────────────────────────────
# Variáveis de ambiente — copie para .env.local e preencha os valores reais.
# Nunca comite valores reais neste arquivo.
# ──────────────────────────────────────────────────────────────────────────────

# ── Banco de dados (Supabase / Postgres) ──────────────────────────────────────
DATABASE_URL=
DATABASE_DIRECT_URL=

# ── Supabase Auth ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_APP_ENV=local   # local | staging | production
# APP_ENV=local

# ── E-mail transacional (Resend) ──────────────────────────────────────────────
RESEND_API_KEY=
NEXT_PUBLIC_FROM_EMAIL=

# ── IA generativa (Google Gemini) ─────────────────────────────────────────────
GEMINI_API_KEY=

# ── Monitoramento (Sentry) — opcionais ───────────────────────────────────────
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# ── Rate-limit (Upstash Redis) — opcional ─────────────────────────────────────
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── Storage (Cloudflare R2) — opcional ────────────────────────────────────────
# CLOUDFLARE_R2_ENDPOINT=
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# CLOUDFLARE_R2_BUCKET_NAME=
# NEXT_PUBLIC_R2_PUBLIC_URL=

# ── RNDS (módulo congelado) — opcional ────────────────────────────────────────
# RNDS_ENABLED=false   # integração federal (pós-contrato); manter false no protótipo
# RNDS_AUTH_URL=
# RNDS_CLIENT_ID=
# RNDS_CLIENT_SECRET=
# RNDS_BASE_URL=
# RNDS_CERT_PFX_PATH=
# RNDS_CERT_PFX_BASE64=
# RNDS_CERT_CA_PATH=
# RNDS_CERT_CA_BASE64=
# RNDS_CERT_PASSPHRASE=
# RNDS_REJECT_UNAUTHORIZED=true

# ── Observabilidade — opcional ────────────────────────────────────────────────
# LOG_LEVEL=info
